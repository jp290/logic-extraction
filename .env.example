# Copy to .env (Bun loads it automatically). Only DEEPSEEK_API_KEY is required.

# ── Model ─────────────────────────────────────────────────
DEEPSEEK_API_KEY=
# Override for a proxy or a test double; must speak the chat-completions API
# and accept the model names deepseek-chat / deepseek-v4-pro.
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ── Server ────────────────────────────────────────────────
# PORT=3471
# Keep 127.0.0.1 behind a reverse proxy: X-Forwarded-For is trusted from loopback only,
# and the proxy must overwrite it with the real client IP (never pass the visitor's through).
# HOST=127.0.0.1
# Base URL used in canonical links (OKF bundles, lens pages).
# PUBLIC_URL=http://localhost:3471
# SQLite lives in $DATA_DIR/extractions.db (default ./data).
# DATA_DIR=./data

# ── Public deployment ─────────────────────────────────────
# NODE_ENV=production
# Required in production: browser requests from other origins are rejected.
# ALLOWED_ORIGIN=https://example.org
# Salt for hashed client IPs; without it rate limits reset on every restart.
IP_HASH_SALT=
# Extraction limit window (6 extractions per IP per window) and max source size.
# RATE_LIMIT_MINUTES=60
# MAX_WORDS=400000

# ── Optional ──────────────────────────────────────────────
# Enables /api/internal/* (external Logic Document synthesis, unthrottled merges).
# Must be at least 32 characters; leave empty to keep the endpoints inert.
# INTERNAL_API_TOKEN=
# Experimental cross-synthesis agent X (off by default: it adds net fabrication).
# CROSS_SYNTHESIS_ENABLED=0
# Python with numpy + scipy for grounding packs (default tools/pack/.venv/bin/python).
# PACK_PYTHON=
